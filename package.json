{
  "name": "hangu-branded-shoes",
  "version": "2.0.0",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"magenta.bold,cyan.bold\" \"npm --prefix backend run dev\" \"next dev -p 3000\"",
    "dev:front": "next dev -p 3000",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"magenta.bold,cyan.bold\" \"npm --prefix backend run dev\" \"next dev -p 3000\"",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('.next')) fs.rmSync('.next', {recursive:true, force:true});\"",
    "dev:backend": "npm --prefix backend run dev",
    "build": "next build",
    "build:backend": "npm --prefix backend run build",
    "build:all": "npm run build:backend && npm run build",
    "start": "next start",
    "start:backend": "npm --prefix backend run start",
    "test": "npm --prefix backend run test",
    "seed": "npm --prefix backend run seed"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.3",
    "heic-convert": "^2.1.0",
    "lucide-react": "^1.66.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.4"
  }
}
